{
  "name": "roy-consultancy",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* run dev",
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter api run prisma:generate",
    "db:migrate": "pnpm --filter api run prisma:migrate",
    "db:seed": "pnpm --filter api run prisma:seed",
    "docker:up": "docker compose -f infra/docker/compose.yml --env-file .env up -d --build",
    "docker:down": "docker compose -f infra/docker/compose.yml --env-file .env down",
    "docker:dev": "docker compose -f infra/docker/compose.dev.yml --env-file .env up -d"
  }
}
