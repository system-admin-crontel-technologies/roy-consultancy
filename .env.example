# ---------------------------------------------------------------------------
# Roy Consultancy Operations Platform - environment template
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR

# --- Web (Next.js) ----------------------------------------------------------
WEB_PORT=3000
# URL the browser uses to reach the public web app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Public website (NEXT_PUBLIC_* values are inlined into the web build) ---
# Leave blank to keep the bracketed placeholders from the design until the client confirms details.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OFFICE_ADDRESS=
NEXT_PUBLIC_OFFICE_CITY=
NEXT_PUBLIC_OFFICE_HOURS=
NEXT_PUBLIC_ADVOCATE_NAME=
NEXT_PUBLIC_BAR_COUNCIL=
# Photo paths served from apps/web/public, e.g. /images/hero.jpg (blank = labelled placeholder)
NEXT_PUBLIC_HERO_PHOTO=
NEXT_PUBLIC_CONSULTATION_PHOTO=
NEXT_PUBLIC_PROFILE_PHOTO=
NEXT_PUBLIC_WORK_PHOTO_1=
NEXT_PUBLIC_WORK_PHOTO_2=
NEXT_PUBLIC_WORK_PHOTO_3=
NEXT_PUBLIC_SHOW_WHATSAPP=true
NEXT_PUBLIC_SHOW_CALENDAR=true
NEXT_PUBLIC_SHOW_RECENT_WORK=true
# URL the Next.js server uses to reach the API (inside Docker: http://api:4000)
API_INTERNAL_URL=http://localhost:4000

# --- API (NestJS) -----------------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Cookie settings for browser sessions
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# JWT signing secret for access tokens (min 32 chars). Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
# Refresh tokens are random, hashed at rest; this is their lifetime
REFRESH_TOKEN_TTL_SECONDS=1209600
INVITE_TOKEN_TTL_SECONDS=259200
PASSWORD_RESET_TTL_SECONDS=3600

# --- Database ---------------------------------------------------------------
POSTGRES_USER=roy
POSTGRES_PASSWORD=roy_dev_password
POSTGRES_DB=roy_consultancy
POSTGRES_PORT=5440
DATABASE_URL=postgresql://roy:roy_dev_password@localhost:5440/roy_consultancy?schema=public

# --- Redis / Valkey (queues) ------------------------------------------------
REDIS_PORT=6390
REDIS_URL=redis://localhost:6390

# --- Object storage (MinIO locally, any S3-compatible store in production) ---
S3_ENDPOINT=http://localhost:9010
S3_REGION=ap-south-1
S3_BUCKET=roy-documents
S3_ACCESS_KEY=roy_s3_admin
S3_SECRET_KEY=roy_s3_dev_password
S3_PORT=9010
S3_CONSOLE_PORT=9011

# --- Email (Mailpit locally) ------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1035
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Roy Consultancy <no-reply@royconsultancy.local>"
MAILPIT_UI_PORT=8035

# --- Malware scanning (ClamAV) ---------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3320

# --- Initial Super Admin (used by seed only; change after first login) ------
SEED_SUPER_ADMIN_EMAIL=admin@royconsultancy.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!12345
SEED_SUPER_ADMIN_NAME="Platform Administrator"
# Set to true to also insert clearly marked demo records (never in production)
SEED_DEMO_DATA=true
